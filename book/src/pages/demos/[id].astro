---
import Base from '../../layouts/Base.astro';
import Player from '../../demos/Player.tsx';
import { SCENARIOS } from '../../demos/catalog';
import { highlightLines } from '../../lib/highlight';
import { withBase } from '../../lib/subjects';
import type { Scenario } from '../../demos/engine/types';

export function getStaticPaths() {
  return SCENARIOS.map((s) => {
    const same = SCENARIOS.filter((x) => x.runtime === s.runtime);
    const j = same.findIndex((x) => x.id === s.id);
    return { params: { id: s.id }, props: { scenario: s, prev: same[j - 1], next: same[j + 1] } };
  });
}
interface Props { scenario: Scenario; prev?: Scenario; next?: Scenario }
const { scenario, prev, next } = Astro.props;
const codeHtml = await highlightLines(scenario.code);
const rtName = scenario.runtime === 'js' ? 'JavaScript · browser runtime' : 'Node.js · libuv runtime';
---
<Base title={`${scenario.title} — Demo`} description={scenario.blurb} subject={scenario.runtime} active="demos" bodyClass="demo-page">
  <main id="content" class="demo-wrap">
    <nav class="demo-crumbs" aria-label="Breadcrumb">
      <a href={withBase('/demos/')}>Demo Lab</a><span aria-hidden="true">/</span><span>{scenario.runtime === 'js' ? 'JavaScript' : 'Node.js'}</span><span aria-hidden="true">/</span><span>{scenario.group}</span>
    </nav>
    <header class="demo-head">
      <div>
        <p class="caps demo-rt">{rtName}</p>
        <h1>{scenario.title}</h1>
        <p class="demo-blurb">{scenario.blurb}</p>
      </div>
      <div class="demo-keys" aria-label="Keyboard shortcuts">
        <span><kbd>←</kbd><kbd>→</kbd> step</span>
        <span><kbd>space</kbd> play</span>
        <span><kbd>R</kbd> restart</span>
      </div>
    </header>

    <Player client:load scenario={scenario} codeHtml={codeHtml} />

    <div class="demo-foot">
      {scenario.chapter ? (
        <a class="demo-chapter" href={withBase(`/${scenario.chapter}/`)}>
          <span class="caps">Read the chapter</span>
          <span>The theory behind this demo →</span>
        </a>
      ) : <span />}
      <nav class="demo-pager" aria-label="More demos">
        {prev && <a href={withBase(`/demos/${prev.id}/`)}><span class="caps">← Previous demo</span>{prev.title}</a>}
        {next && <a class="nx" href={withBase(`/demos/${next.id}/`)}><span class="caps">Next demo →</span>{next.title}</a>}
      </nav>
    </div>
  </main>
</Base>

<style>
  .demo-wrap { max-width: 1360px; margin: 0 auto; padding: 28px 28px 64px; }
  .demo-crumbs { display: flex; gap: 8px; font-size: 12.5px; color: var(--faint); margin-bottom: 18px; }
  .demo-crumbs a { color: var(--muted); text-decoration: none; }
  .demo-crumbs a:hover { color: var(--ink); }
  .demo-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 20px; flex-wrap: wrap; }
  .demo-rt { color: var(--subj); margin: 0 0 6px; }
  .demo-head h1 { font-family: var(--font-read); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 600; letter-spacing: -0.015em; color: var(--ink); margin: 0 0 6px; line-height: 1.2; }
  .demo-blurb { margin: 0; font-family: var(--font-read); font-style: italic; color: var(--muted); font-size: 17px; }
  .demo-keys { display: flex; gap: 14px; font-size: 12px; color: var(--muted); }
  .demo-keys kbd { margin-right: 3px; }
  .demo-foot { display: grid; grid-template-columns: 1fr 2fr; gap: 20px; margin-top: 28px; }
  .demo-chapter, .demo-pager a {
    display: flex; flex-direction: column; gap: 3px; padding: 14px 16px;
    border: 1px solid var(--rule); border-radius: 6px; text-decoration: none; color: var(--ink); font-weight: 550; font-size: 14.5px;
  }
  .demo-chapter:hover, .demo-pager a:hover { border-color: var(--rule-strong); background: var(--bg-raised); }
  .demo-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .demo-pager .nx { text-align: right; grid-column: 2; }
  @media (max-width: 800px) {
    .demo-wrap { padding: 20px 14px 48px; }
    .demo-foot, .demo-pager { grid-template-columns: 1fr; }
    .demo-pager .nx { grid-column: 1; }
    .demo-keys { display: none; }
  }
</style>
